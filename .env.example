# ============================================================
# Sentinel-Agent: Environment Variables Template
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env file to Git.
# ============================================================

# --- LLM Provider (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Weather API (OpenWeatherMap - free tier) ---
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# --- News API ---
# Get your free key at: https://newsapi.org/
NEWS_API_KEY=your-newsapi-key-here

# --- Langfuse Observability ---
# Sign up free at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application Settings ---
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
DB_PATH=./database/sentinel.db

# --- Security ---
# Maximum number of ReAct loop iterations before force-stopping
MAX_REACT_ITERATIONS=10

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
